# Copiar a .env.local.
#
# Mientras no se defina VITE_API_URL:
# - El login del panel es demo local (admin@catedra.edu.ar / catedra2026).
# - El CRUD de contenido (unidades, bibliografía, etc.) sigue en localStorage.
#
# Al definir VITE_API_URL (con tdj-backend corriendo):
# - El login pasa a ser real contra el backend (JWT + roles).
# - "Mi cuenta" y "Administradores" pasan a hablar con el backend real.
# - El resto del CRUD de contenido sigue en localStorage por ahora — migrar
#   esa parte a la API es el siguiente paso pendiente (ver README).

# VITE_API_URL="http://localhost:4000/api"
